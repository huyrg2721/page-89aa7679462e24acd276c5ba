lid var(--deep-3);padding: 28px 30px 30px;display: grid;grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);gap: 20px 44px;align-items: start}\n  .plan.s1 {margin-right: 16%}\n  .plan.s2 {margin-right: 8%;margin-left: 8%;border-left-color: var(--amber);background: #fffdf8}\n  .plan.s3 {margin-left: 16%;border-left-color: var(--deep)}\n  .plan .name-row {display: flex;align-items: baseline;gap: 12px;flex-wrap: wrap}\n  .plan h3 {font-size: 1.28rem;color: var(--deep)}\n  .tag {font-size: 11.5px;letter-spacing: .12em;background: var(--amber);color: #24190a;padding: 2px 9px;font-weight: 700}\n  .plan .price {font-size: 1.72rem;font-weight: 700;color: var(--deep);margin: 8px 0 2px;letter-spacing: .01em}\n  .plan .price small {font-size: .44em;font-weight: 400;color: var(--ink-soft);letter-spacing: .06em}\n  .plan .annual {font-size: 13.5px;color: var(--ink-soft);margin: 0}\n  .plan ul {font-size: .95rem;color: var(--ink)}\n  .plan ul li::marker {color: var(--amber)}\n  .plans-foot {margin-top: 30px;font-size: 13.5px;color: var(--ink-soft);max-width: 52em;border-top: 1px dashed #c3bbab;padding-top: 18px}\n\n  /* ---------- 客户端 ---------- */\n  .clients {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 10px 46px}\n  .client {padding: 18px 0;border-bottom: 1px solid var(--line)}\n  .client h3 {font-size: 1rem;color: var(--deep);margin-bottom: 6px}\n  .client p {margin: 0;font-size: .93rem;color: var(--ink-soft)}\n  .clients-note {margin-top: 26px;font-size: 13.5px;color: var(--ink-soft);max-width: 52em}\n\n  /* ---------- FAQ 分组 ---------- */\n  .faq {background: var(--deep);color: #e7eef3}\n  .faq .sec-head h2 {color: #fff}\n  .faq .sec-head p {color: #a9c2d3}\n  .faq-groups {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 34px 54px}\n  .faq-group h3 {font-size: .82rem;letter-spacing: .2em;color: var(--amber);font-weight: 600;padding-bottom: 10px;border-bottom: 1px solid var(--line-dark);margin-bottom: 18px}\n  .qa {margin-bottom: 20px}\n  .qa:last-child {margin-bottom: 0}\n  .qa .q {font-weight: 600;color: #fff;margin: 0 0 5px;font-size: .98rem}\n  .qa .a {margin: 0;color: #bed0dc;font-size: .93rem}\n\n  /* ---------- 页脚 ---------- */\n  footer {background: #081826;color: #93aabb;font-size: 13px;padding: 30px 0 36px;border-top: 3px solid var(--amber)}\n  footer .wrap {display: flex;flex-wrap: wrap;gap: 8px 32px}\n  footer strong {color: #dfe8ee;letter-spacing: .1em;font-weight: 600}\n  footer p {margin: 0}\n\n  /* ---------- 适配 ---------- */\n  @media (max-width: 900px) {.hero-grid { grid-template-columns: 1fr;gap: 34px;padding: 46px 0 44px;}\n    .steps { grid-template-columns: 1fr;gap: 28px;}\n    .plan, .plan.s1, .plan.s2, .plan.s3 {\n      grid-template-columns: 1fr;margin-left: 0;margin-right: 0;gap: 14px;padding: 24px 22px 26px;}\n    .clients { grid-template-columns: 1fr;}\n    .faq-groups { grid-template-columns: 1fr;gap: 30px;}\n    section { padding: 48px 0;}\n    .topbar nav { margin-left: 0;}}\n  @media (max-width: 520px) {\n    body {font-size: 15.5px}\n    .topbar .wrap {font-size: 12.5px}\n    .plan .price {font-size: 1.5rem}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <span class=\"mark\">菲菲云</span>\n    <nav aria-label=\"页面目录\">\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"eyebrow\">订阅说明 · 第三版</p>\n        <h1>菲菲云\n          <span class=\"thin\">订阅方案与使用说明</span>\n        </h1>\n        <p class=\"lead\">这份页面以说明书的方式编写：先给出<b>全部套餐的名称、价格和权益条目</b>，再说明开通后如何在自己的设备上完成配置，最后按主题集中回答常见疑问。<strong>不承诺未写明的事项</strong>，也不使用无法核实的表述。凡本页未列出的能力，均视为不在服务范围内。</p>\n        <div class=\"hero-notes\">\n          <span>三档订阅：基础版 / 旗舰版 / 团队版</span>\n          <span>月付与年付两种计费口径</span>\n          <span>设备数量按套餐分别限定</span>\n        </div>\n      </div>\n\n      <aside class=\"panel\" aria-label=\"关键信息速览\">\n        <h2>关键信息</h2>\n        <dl>\n          <dt>订阅档位</dt>\n          <dd>基础版、旗舰版、团队版，共三档</dd>\n          <dt>计费方式</dt>\n          <dd>按月计费，或按年计费（年付为单独价格）</dd>\n          <dt>流量口径</dt>\n          <dd>每档套餐按月给出当月可用额度，额度随套餐不同</dd>\n          <dt>同时在线</dt>\n          <dd>基础版 3 台、旗舰版 5 台、团队版 20 台</dd>\n          <dt>配置方式</dt>\n          <dd>在官方客户端内导入订阅信息，或在系统代理设置中手动填写</dd>\n          <dt>支持渠道</dt>\n          <dd>工单。旗舰版与团队版为优先处理，团队版另设专属客户经理</dd>\n        </dl>\n        <p class=\"panel-foot\">本页价格与权益以正文所列条目为准；未列明的功能、线路与保障不在承诺范围内。</p>\n      </aside>\n    </div>\n  </header>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>使用说明</h2>\n        <p>开通订阅后，按以下三步完成配置。每一步都以“你手上应该有什么”为前提，缺少前提时请先补齐，再进行下一步。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <p class=\"num\">步骤 01</p>\n          <h3>先确认套餐与设备数量</h3>\n          <p>核对所选档位允许的同时在线设备数：基础版 3 台、旗舰版 5 台、团队版 20 台。超出数量时，后登录的设备可能挤下先登录的设备。若设备较多，请直接选择团队版，避免在月中反复调整。</p>\n        </article>\n        <article class=\"step\">\n          <p class=\"num\">步骤 02</p>\n          <h3>取得订阅信息</h3>\n          <p>订阅信息由两部分组成：账号凭据与订阅配置。请在自己持有的设备上保存，不要转发给不需要使用的人。团队版建议由一名管理员统一保管，再按成员分发各自的配置。</p>\n        </article>\n        <article class=\"step\">\n          <p class=\"num\">步骤 03</p>\n          <h3>导入客户端并验证</h3>\n          <p>按本页“客户端”一节的说明，在对应系统上导入配置并启动。启动后先访问一个普通网页确认可用，再切换到你需要使用的场景。若无法连通，先检查是否误改了系统代理设置，再提交工单。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>套餐与价格</h2>\n        <p>三档套餐按从低到高依次排列。每档同时给出月付价格与年付价格，年付价格是该档的独立标价，不是折扣比例。权益条目逐条列出，未列出者不算在内。</p>\n      </div>\n\n      <div class=\"stairs\">\n\n        <article class=\"plan s1\">\n          <div>\n            <div class=\"name-row\">\n              <h3>基础版</h3>\n            </div>\n            <p class=\"price\">¥15<small> / 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan s2\">\n          <div>\n            <div class=\"name-row\">\n              <h3>旗舰版</h3>\n              <span class=\"tag\">推荐</span>\n            </div>\n            <p class=\"price\">¥35<small> / 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan s3\">\n          <div>\n            <div class=\"name-row\">\n              <h3>团队版</h3>\n            </div>\n            <p class=\"price\">¥85<small> / 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plans-foot\">说明：以上价格与权益为本页列出的全部套餐内容。流量额度按套餐分别计算，不跨档位累计；同时在线设备数指同一时间处于连接状态的设备上限。年付价格与月付价格并列给出，两者不叠加。如需变更档位，请通过工单说明目标档位与生效时间。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端</h2>\n        <p>客户端的选择取决于你的设备系统。下表说明各系统应当准备的环境与操作路径；具体安装包与配置入口以你实际取得的客户端为准，本页不提供下载地址。</p>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>Windows</h3>\n          <p>使用桌面客户端导入订阅配置，导入后在客户端内选择线路并启用系统代理。若与其他代理软件同时运行，请先关闭其一，避免两者争用系统代理设置。</p>\n        </article>\n        <article class=\"client\">\n          <h3>macOS</h3>\n          <p>导入配置后需在系统设置中允许客户端修改网络设置，否则不会生效。首次启用时系统会要求确认，请按提示完成授权，再回到客户端查看连接状态。</p>\n        </article>\n        <article class=\"client\">\n          <h3>Android</h3>\n          <p>在客户端内导入配置并建立本地连接。部分系统版本会限制后台运行，请在电池设置中将客户端加入不受限制的名单，否则锁屏后可能断开。</p>\n        </article>\n        <article class=\"client\">\n          <h3>iOS / iPadOS</h3>\n          <p>导入配置后按系统提示添加网络配置描述文件，并在设置中启用。切换网络（如从 Wi-Fi 转到蜂窝）后，建议重新启用一次以确保配置生效。</p>\n        </article>\n        <article class=\"client\">\n          <h3>路由器</h3>\n          <p>若在路由器上配置，需要路由器本身支持导入订阅或手动填写代理参数。此项属于设备能力，不由套餐决定；配置前请先确认路由器固件是否具备该功能。</p>\n        </article>\n        <article class=\"client\">\n          <h3>多设备协同</h3>\n          <p>同一账号下的设备共用套餐限定的同时在线数量。切换设备时请先在旧设备上断开，再在新设备上连接，这样可以避免触发数量上限。</p>\n        </article>\n      </div>\n\n      <p class=\"clients-note\">客户端本节仅说明操作路径与环境前提。本页不提供安装包、下载链接与版本号；如客户端已停止维护或系统版本不再支持，请通过工单确认当前可用方案。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>按主题分组：计费与套餐、配置与设备、使用与支持。每组内的问题各自独立，回答只涉及本页已写明的内容。</p>\n      </div>\n\n      <div class=\"faq-groups\">\n\n        <div class=\"faq-group\">\n          <h3>计费与套餐</h3>\n          <div class=\"qa\">\n            <p class=\"q\">年付价格是月付打折算出来的吗？</p>\n            <p class=\"a\">不是。年付价格是各档位单独标出的一个数字：基础版 ¥150 / 年、旗舰版 ¥350 / 年、团队版 ¥850 / 年。它与月付价格并列存在，两种计费方式不叠加使用。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">三档套餐的主要差异在哪里？</p>\n            <p class=\"a\">差异集中在三处：每月流量额度（100GB / 300GB / 1000GB）、同时在线设备数（3 / 5 / 20 台）、以及线路与支持范围。旗舰版与团队版在流媒体与线路条目上另有单独列出的内容。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">用了半个月想换档位，怎么处理？</p>\n            <p class=\"a\">请在工单中说明当前档位、目标档位和希望的生效时间。由于各档价格与权益分别标注，变更涉及的具体处理方式需由支持人员按你的订阅状态确认，本页不预设折算规则。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>配置与设备</h3>\n          <div class=\"qa\">\n            <p class=\"q\">超过同时在线设备数会怎样？</p>\n            <p class=\"a\">当连接设备数超过套餐上限时，后连接的设备可能无法保持连接，或使先前的设备断开。基础版上限为 3 台，旗舰版为 5 台，团队版为 20 台。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">导入配置后无法打开网页，先检查什么？</p>\n            <p class=\"a\">按顺序检查三项：客户端是否已启用（而非仅导入）、系统代理是否指向该客户端、是否有另一个代理软件在同一时间修改了系统代理。三项都确认后仍不通，再提交工单并附上系统版本与客户端状态描述。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">可以在路由器上使用吗？</p>\n            <p class=\"a\">取决于路由器固件是否支持导入订阅或手动填写代理参数，这属于设备自身能力，不由套餐决定。配置前请先确认固件具备该功能，再按客户端一节的方式操作。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>使用与支持</h3>\n          <div class=\"qa\">\n            <p class=\"q\">流量额度是怎么计算的？</p>\n            <p class=\"a\">每档套餐按月给出当月可用额度，各档分别计算，不跨档累计。具体剩余量请以客户端内显示的数据为准。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">工单的处理顺序是怎样的？</p>\n            <p class=\"a\">基础版通过常规工单提交；旗舰版为 7x24 优先工单支持；团队版在优先工单之外另设专属客户经理。提交时请写清套餐档位与问题现象，便于直接定位。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">团队版可以为企业做定制路由吗？</p>\n            <p class=\"a\">团队版权益中列有“支持企业定制路由”与“专属客户经理服务”。具体可定制的范围需与客户经理逐项确认，本页不对未写明的实现方式作出承诺。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>信息边界</h3>\n          <div class=\"qa\">\n            <p class=\"q\">本页没有提到的功能，算不算包含在内？</p>\n            <p class=\"a\">不算。本页以列出的条目为承诺范围；凡未在套餐列表或说明中出现的功能、线路、保障与指标，均不在承诺之内。</p>\n          </div>\n          <div class=\"qa\">\n            <p class=\"q\">页面上的价格会变吗？</p>\n            <p class=\"a\">本页展示的是撰写时的标价：基础版 ¥15 / 月或 ¥150 / 年，旗舰版 ¥35 / 月或 ¥350 / 年，团队版 ¥85 / 月或 ¥850 / 年。如与实际开通时的标价不一致，以开通时的说明为准。</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p><strong>菲菲云</strong></p>\n    <p>订阅方案与使用说明 · 三档套餐、月付与年付两种计费口径</p>\n    <p>本页不提供下载地址与交易链接，价格与权益以正文列出条目为准。</p>\n  </div>\n</footer>",
